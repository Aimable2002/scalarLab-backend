# Replace with the SQLAlchemy-compatible connection string from your Supabase project.
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Set only for legacy projects that still sign access tokens with HS256.
# SUPABASE_JWT_SECRET=replace-with-server-side-jwt-secret
SCALARLAB_JWT_AUDIENCE=authenticated
REDIS_URL=rediss://USER:PASSWORD@YOUR_REDIS_HOST:PORT/0
OBJECT_STORAGE_BUCKET=YOUR_PRIVATE_BUCKET
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT_URL=https://YOUR_S3_COMPATIBLE_ENDPOINT
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-server-side-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-server-side-secret-key
OBJECT_STORAGE_URL_TTL_SECONDS=900
OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS=7200
MODAL_APP_NAME=scalar-lab
MODAL_FUNCTION_NAME=execute-job
MODAL_GPU_TYPE=
MODAL_WORKER_SECRET_NAME=scalar-lab-worker-secrets